# CaudalFlow BFF server-side configuration
# Copy to docker/data/bff.env and fill in what you need:
#   cp docker/data/bff.env.example docker/data/bff.env
#
# All values are optional — without this file the stack still boots, and keys
# entered in the browser Settings panel are sent per-request and take
# precedence over the ones below.

# Server-side API keys (used when the browser doesn't provide its own key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM runtime for /api/agent: anthropic | openai | gemini
AGENT_RUNTIME=anthropic

# Optional overrides (defaults are set in compose.yaml)
# PORT=4000
# FRONTEND_ORIGIN=http://localhost:8088
